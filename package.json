{
  "name": "resume-from",
  "version": "0.0.0",
  "description": "Continue a coding session in a different agent, or a different profile.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "resume-from": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./pi-extension": "./dist/host/pi-extension/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0"
  }
}
