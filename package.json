{
  "name": "resume-from",
  "version": "0.1.5",
  "description": "Continue a coding session in a different agent, or a different profile.",
  "keywords": [
    "pi-package",
    "coding-agent",
    "session-handoff",
    "claude-code",
    "codex"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "resume-from": "./dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi-extension": {
      "types": "./dist/host/pi-extension/index.d.ts",
      "import": "./dist/host/pi-extension/index.js"
    }
  },
  "files": [
    "dist",
    "shims/pi"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "packages:stage": "npm run build && node scripts/release/stage-npm-packages.mjs",
    "packages:check": "npm run packages:stage && node scripts/release/check-npm-packages.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0"
  },
  "pi": {
    "extensions": [
      "./shims/pi/extensions/resume-from.js"
    ],
    "image": "https://raw.githubusercontent.com/alexei-led/resume-from/implement-resume-from/assets/resume-from-card.png"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexei-led/resume-from.git"
  },
  "homepage": "https://github.com/alexei-led/resume-from#readme",
  "bugs": {
    "url": "https://github.com/alexei-led/resume-from/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
